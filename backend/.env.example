# Backend Environment Variables

# JWT Configuration
JWT_SECRET=your_secure_jwt_secret_key_here_min_32_chars

# Seed Data Passwords (used only during database initialization)
# Change these before running seed script in production
ADMIN_SEED_PASSWORD=ChangeMe@123
WORKER_SEED_PASSWORD=ChangeMe@456

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/trinetra

# Server
PORT=5001
NODE_ENV=development

# API Settings
API_BASE_URL=http://localhost:5001
