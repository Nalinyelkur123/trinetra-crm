{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend/src/index.js",
      "routePrefix": "/api",
      "framework": "express",
      "includeFiles": "backend/database.sqlite"
    }
  }
}
